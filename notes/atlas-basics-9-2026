# operators
# set is used to update if meant to replace
# push is meant to append a new field or add if nothing exists

# upsert - update or insert if doesn't exist

db.podcasts.updateOne(
  {
    _id: ObjectId("5e8f8f8f8f8f8f8f8f8f8f8"),
  },

  {
    $set: {
      subscribers: 98562,
    },
  }
)


db.podcasts.updateOne(
  { title: "The Developer Hub" },
  { $set: { topics: ["databases", "MongoDB"] } },
  { upsert: true }
)

db.podcasts.updateOne(
  { _id: ObjectId("5e8f8f8f8f8f8f8f8f8f8f8") },
  { $push: { hosts: "Nic Raboy" } }
)



db.movies.updateOne(
  { title: "Inception" },
  { $push: { genres: { $each: ["Sci-Fi", "Thriller"] } } }
)

db.birds.updateOne({
_id: ObjectId('6268471e613e55b82d7065d7')
}, 
