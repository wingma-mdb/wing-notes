)

db.birds.updateOne({ common_name: 'Robin Redbreast' }, { $inc: { sightings: 1 }, $set: { last_updated: new Date() } }, { upsert: true })


db.birds.findAndModify({_id: ObjectId('628682d92f3fa87b7d86dcce')},{sightings_count: 5}, true)
